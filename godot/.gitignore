# Godot editor caches and imported artefacts (GODOT_HANDOFF.md §10)
.godot/
*.translation
.import/

# export_presets.cfg IS committed. It is normally ignored because it can carry
# keystore passwords; this one carries none, and the web build's settings —
# thread_support off above all — are the kind of thing that must not live only
# on one machine.

# Synced canon. data/ is a byte-identical COPY of the canonical JSON and the
# registered art above this folder — see tools/sync-data.mjs. Committing it
# would put two copies of canon in one repository, which is the drift this
# project has paid for elsewhere. Regenerate it with:
#
#     node tools/sync-data.mjs
#
data/

# The 9.6MB upstream Noto Sans JP that tools/build-font-subset.py subsets from.
# The SUBSET (ui/fonts/, ~150KB a weight) is committed because the web build
# cannot render Japanese without it; the source it was cut from is a download,
# and a download does not belong in a repository.
tools/.fontcache/
tools/__pycache__/

# Generated by tools/locale-review.mjs for a native read — derived, not source.
locale/review.html
