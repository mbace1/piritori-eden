      "id": "news-markka-afterlife",
      "day": 3,
      "channel": "scheduled-tv",
      "presenter": "Arvo Linde",
      "documented": "Markka notes and coins ceased to be legal tender after February 2002. The irrevocable conversion rate is 5.94573 markka per euro, and redemption remained available through the Bank of Finland until 29 February 2012.",
      "inference": "Old cash can still appear in homes and informal payments even though ordinary shops cannot treat it as current money.",
      "accusation": null,
      "fiction": "The slice's staffed Siltasaari counter and its visibility consequences are fictional gameplay services.",
      "arvo_copy": "The markka is no longer money at the till. Its value is fixed; recovering that value still requires a journey.",
      "sources": [
        "https://www.suomenpankki.fi/en/bank-of-finland/art-and-history/the-markka/",
        "https://www.ecb.europa.eu/press/pr/date/1998/html/pr981231_2.en.html"
      ],
      "effects": ["reveal:staffed_bank", "label:markka-dead-money"]
    }
